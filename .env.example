# ==============================================================================
# Akula Topping — Server & Database Environment Variables
# Copy this file to .env.local (never commit .env.local) and fill in real values.
# ==============================================================================

# --- Single Admin Authentication (Server-Only, NEVER expose to client) ---
# Exact email allowed to log in as the sole website administrator
ADMIN_EMAIL=Akulatopping@gmail.com

# Salted scrypt password hash in format: scrypt:<saltHex>:<hashHex>
# Generate a hash using: pnpm run admin:hash "YourStrongPassword"
ADMIN_PASSWORD_HASH=scrypt:replace_with_salt_hex:replace_with_64_byte_hash_hex

# Cryptographic secret (minimum 32 random chars / 64 hex chars) for signing HTTP-only cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters_secret_key

# --- Supabase PostgreSQL & Storage ---
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-Only Privileged Key (NEVER prefix with NEXT_PUBLIC_ or commit to Git)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key

# Optional: override storage bucket name (defaults to product-images)
SUPABASE_STORAGE_BUCKET=product-images
